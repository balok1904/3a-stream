# ============================================================================
# 3A STREAM - CONFIGURAÇÃO DE AMBIENTE E SEGURANÇA (.env.example)
# Copie este arquivo para ".env" (que é ignorado pelo Git) ou configure estas
# variáveis no painel "Environment" da hospedagem (Render / VPS / Cloud).
# ============================================================================

PORT=3000
NODE_ENV=production

# Credenciais do Painel Administrativo (/admin)
ADMIN_USER=seu_usuario_admin
ADMIN_PASS=sua_senha_forte_aqui
ADMIN_SECRET=gere_uma_chave_secreta_longa_e_aleatoria_aqui

# Limite de tentativas de login por IP (Proteção Anti-Brute-Force)
LOGIN_MAX_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=10
